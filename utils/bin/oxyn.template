#!/usr/bin/env bash

export NVIM_APPNAME="${NVIM_APPNAME:-NVIM_APPNAME_VAR}"

export OXYN_RUNTIME_DIR="${OXYN_RUNTIME_DIR:-RUNTIME_DIR_VAR}"
export OXYN_CONFIG_DIR="${OXYN_CONFIG_DIR:-CONFIG_DIR_VAR}"
export OXYN_CACHE_DIR="${OXYN_CACHE_DIR:-CACHE_DIR_VAR}"
export OXYN_BASE_DIR="${OXYN_BASE_DIR:-BASE_DIR_VAR}"

exec -a "$NVIM_APPNAME" nvim -u "$OXYN_BASE_DIR/init.lua" "$@"
