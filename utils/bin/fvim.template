#!/usr/bin/env bash

export NVIM_APPNAME="${NVIM_APPNAME:-NVIM_APPNAME_VAR}"

export FOURSHVIM_RUNTIME_DIR="${FOURSHVIM_RUNTIME_DIR:-RUNTIME_DIR_VAR}"
export FOURSHVIM_CONFIG_DIR="${FOURSHVIM_CONFIG_DIR:-CONFIG_DIR_VAR}"
export FOURSHVIM_CACHE_DIR="${FOURSHVIM_CACHE_DIR:-CACHE_DIR_VAR}"
export FOURSHVIM_BASE_DIR="${FOURSHVIM_BASE_DIR:-BASE_DIR_VAR}"

exec -a "$NVIM_APPNAME" nvim -u "$FOURSHVIM_BASE_DIR/init.lua" "$@"
